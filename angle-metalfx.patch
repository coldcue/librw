+// MetalFX temporal upscaling: C exports for the client (librw), resolved with
+// dlsym(). Both are called on the GL thread; SetFrameParams right before
+// eglSwapBuffers(), which consumes the values on the same thread.
+extern "C" __attribute__((visibility("default"))) int rwANGLEMetalFXTemporalStatus(void)
+{
+    return rx::gMetalFXTemporalActive;
+}
+
+extern "C" __attribute__((visibility("default"))) void rwANGLEMetalFXSetFrameParams(
+    const float reprojMatrix[16],
+    float jitterX,
+    float jitterY,
+    int reset,
+    int motionValid)
+{
+// The caller always passes a float[16]; there is no bounds information to
+// carry across this C ABI boundary.
+#pragma clang unsafe_buffer_usage begin
+    for (int i = 0; i < 16; i++)
+    {
+        rx::gMetalFXFrameParams.reproj[i] = reprojMatrix[i];
+    }
+#pragma clang unsafe_buffer_usage end
+    rx::gMetalFXFrameParams.jitterX     = jitterX;
+    rx::gMetalFXFrameParams.jitterY     = jitterY;
+    rx::gMetalFXFrameParams.reset       = reset;
+    rx::gMetalFXFrameParams.motionValid = motionValid;
+}
