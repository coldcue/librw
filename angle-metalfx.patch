+CGSize WindowSurfaceMtl::calcInternalSize(const CGSize &drawableSize) const
+{
+    // Must match librw's mapMetalFXSize() (src/gl/gl3device.cpp). The lower
+    // clamp keeps the spatial scaler's per-axis factor within its [1,2] range.
+    int outW = static_cast<int>(drawableSize.width);
+    int outH = static_cast<int>(drawableSize.height);
+    int pct  = static_cast<int>(mUpscalePct);
+    int inW  = std::max((outW + 1) / 2, std::min(outW, outW * pct / 100));
+    int inH  = std::max((outH + 1) / 2, std::min(outH, outH * pct / 100));
+    return CGSizeMake(inW, inH);
+}
+
+angle::Result WindowSurfaceMtl::ensureOffscreenColorTexture(const gl::Context *context)
+{
+    CGSize internalSize = calcInternalSize(mMetalLayer.get().drawableSize);
+    gl::Extents size(static_cast<int>(internalSize.width), static_cast<int>(internalSize.height),
+                     1);
+
+    if (!mColorTexture || mColorTexture->sizeAt0() != size)
+    {
+        // renderTargetOnly=false: the scaler input needs MTLTextureUsageShaderRead
+        ANGLE_TRY(CreateOrResizeTexture(context, mColorFormat, size.width, size.height, 1,
+                                        /** renderTargetOnly */ false, &mColorTexture));
+        mColorRenderTarget.setWithImplicitMSTexture(mColorTexture, mMSColorTexture,
+                                                    mtl::kZeroNativeMipLevel, 0, mColorFormat);
+    }
+
+    return angle::Result::Continue;
+}
+
+angle::Result WindowSurfaceMtl::encodeUpscaleAndPresent(const gl::Context *context)
+{
+    ANGLE_MTL_OBJC_SCOPE
+    {
+        ContextMtl *contextMtl = mtl::GetImpl(context);
+        ASSERT(mColorTexture);
+
+        if (mMSColorTexture)
+        {
+            ANGLE_TRY(resolveColorTextureIfNeeded(context));
+        }
+
+        // Obtain the drawable only now, at present time.
+        mCurrentDrawable = [mMetalLayer nextDrawable];
+        if (!mCurrentDrawable)
+        {
+            mMetalLayer.get().allowsNextDrawableTimeout = NO;
+            mCurrentDrawable                            = [mMetalLayer nextDrawable];
+            mMetalLayer.get().allowsNextDrawableTimeout = YES;
+        }
+
+        id<MTLTexture> dst = mCurrentDrawable.get().texture;
+        id<MTLTexture> src = mColorTexture->get();
+
+        bool useScaler = false;
+#if ANGLE_METAL_FX_AVAILABLE
+        if (@available(macOS 13.0, macCatalyst 16.0, *))
+        {
+            CGSize inSize  = CGSizeMake(src.width, src.height);
+            CGSize outSize = CGSizeMake(dst.width, dst.height);
+            if (!CGSizeEqualToSize(inSize, outSize))
+            {
+                if (!mSpatialScaler || !CGSizeEqualToSize(mScalerInputSize, inSize) ||
+                    !CGSizeEqualToSize(mScalerOutputSize, outSize))
+                {
+                    auto desc = angle::adoptObjCPtr([[MTLFXSpatialScalerDescriptor alloc] init]);
+                    desc.get().inputWidth          = static_cast<NSUInteger>(inSize.width);
+                    desc.get().inputHeight         = static_cast<NSUInteger>(inSize.height);
+                    desc.get().outputWidth         = static_cast<NSUInteger>(outSize.width);
+                    desc.get().outputHeight        = static_cast<NSUInteger>(outSize.height);
+                    desc.get().colorTextureFormat  = mColorFormat.metalFormat;
+                    desc.get().outputTextureFormat = mColorFormat.metalFormat;
+                    // Both the BGRA8 and the EDR RGBA16F path carry
+                    // sRGB-encoded values (see the colorspace note in
+                    // initialize()), which is what Perceptual expects.
+                    MTLFXSpatialScalerColorProcessingMode mode =
+                        MTLFXSpatialScalerColorProcessingModePerceptual;
+                    const char *modeStr = getenv("ANGLE_METAL_FX_MODE");
+                    if (modeStr != nullptr && modeStr[0] == 'l')
+                    {
+                        mode = MTLFXSpatialScalerColorProcessingModeLinear;
+                    }
+                    else if (modeStr != nullptr && modeStr[0] == 'h')
+                    {
+                        mode = MTLFXSpatialScalerColorProcessingModeHDR;
+                    }
+                    desc.get().colorProcessingMode = mode;
+
+                    mSpatialScaler = angle::adoptObjCPtr([desc.get()
+                        newSpatialScalerWithDevice:contextMtl->getDisplay()->getMetalDevice()]);
+                    mScalerInputSize  = inSize;
+                    mScalerOutputSize = outSize;
+                }
+                useScaler = mSpatialScaler != nil;
+            }
+        }
+
+        if (useScaler)
+        {
+            if (@available(macOS 13.0, macCatalyst 16.0, *))
+            {
+                id<MTLFXSpatialScaler> scaler = mSpatialScaler.get();
+                scaler.colorTexture           = src;
+                scaler.outputTexture          = dst;
+                contextMtl->presentWithPreEncode(context, mCurrentDrawable,
+                                                 [scaler](id<MTLCommandBuffer> cmdBuffer) {
+                                                     [scaler encodeToCommandBuffer:cmdBuffer];
+                                                 });
+            }
+        }
+#endif
+        if (!useScaler)
+        {
+            // No scaler (creation failed or internal size == drawable size):
+            // draw-blit the offscreen texture into the drawable instead.
+            mtl::TextureRef drawableTex = mtl::Texture::MakeFromMetal(dst);
+            RenderTargetMtl drawableRenderTarget;
+            drawableRenderTarget.set(drawableTex, mtl::kZeroNativeMipLevel, 0, mColorFormat);
+            mtl::RenderCommandEncoder *encoder =
+                contextMtl->getRenderTargetCommandEncoder(drawableRenderTarget);
+
+            mtl::ColorBlitParams params;
+            params.enabledBuffers.set(0);
+            params.filter         = GL_LINEAR;
+            params.src            = mColorTexture;
+            params.dstTextureSize = gl::Extents(static_cast<int>(dst.width),
+                                                static_cast<int>(dst.height), 1);
+            params.dstRect = params.dstScissorRect =
+                gl::Rectangle(0, 0, params.dstTextureSize.width, params.dstTextureSize.height);
+            params.srcNormalizedCoords = mtl::NormalizedCoords();
+            ANGLE_TRY(contextMtl->getDisplay()->getUtils().blitColorWithDraw(
+                context, encoder, mColorFormat.actualAngleFormat(), params));
+            contextMtl->endEncoding(true);
+            contextMtl->present(context, mCurrentDrawable);
+        }
+
+        StopFrameCapture();
+        StartFrameCapture(contextMtl);
+
+        mCurrentDrawable = nil;
+
+        return angle::Result::Continue;
+    }
+}
