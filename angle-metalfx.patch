+bool WindowSurfaceMtl::ensureTemporalResources(ContextMtl *contextMtl,
+                                               id<MTLTexture> src,
+                                               id<MTLTexture> dst)
+{
+#if ANGLE_METAL_FX_AVAILABLE
+    if (@available(macOS 13.0, macCatalyst 16.0, *))
+    {
+        CGSize inSize  = CGSizeMake(src.width, src.height);
+        CGSize outSize = CGSizeMake(dst.width, dst.height);
+        if (mTemporalScaler && CGSizeEqualToSize(mScalerInputSize, inSize) &&
+            CGSizeEqualToSize(mScalerOutputSize, outSize))
+        {
+            return true;
+        }
+
+        id<MTLDevice> device = contextMtl->getDisplay()->getMetalDevice();
+
+        auto desc = angle::adoptObjCPtr([[MTLFXTemporalScalerDescriptor alloc] init]);
+        desc.get().inputWidth          = static_cast<NSUInteger>(inSize.width);
+        desc.get().inputHeight         = static_cast<NSUInteger>(inSize.height);
+        desc.get().outputWidth         = static_cast<NSUInteger>(outSize.width);
+        desc.get().outputHeight        = static_cast<NSUInteger>(outSize.height);
+        desc.get().colorTextureFormat  = mColorFormat.metalFormat;
+        desc.get().outputTextureFormat = mColorFormat.metalFormat;
+        desc.get().depthTextureFormat  = MTLPixelFormatR32Float;
+        desc.get().motionTextureFormat = MTLPixelFormatRG16Float;
+        desc.get().autoExposureEnabled = NO;
+        // Compile the final upscaler in the background; the interim one used
+        // for the first frames is slower but produces the same image.
+        desc.get().requiresSynchronousInitialization = NO;
+
+        // A newly created scaler has no history, so no reset is needed here.
+        mTemporalScaler = angle::adoptObjCPtr([desc.get() newTemporalScalerWithDevice:device]);
+        if (!mTemporalScaler)
+        {
+            return false;
+        }
+        mScalerInputSize  = inSize;
+        mScalerOutputSize = outSize;
+
+        // Motion vectors and the depth copy at the internal size.
+        MTLTextureDescriptor *texDesc = [MTLTextureDescriptor
+            texture2DDescriptorWithPixelFormat:MTLPixelFormatRG16Float
+                                         width:static_cast<NSUInteger>(inSize.width)
+                                        height:static_cast<NSUInteger>(inSize.height)
+                                     mipmapped:NO];
+        texDesc.usage       = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+        texDesc.storageMode = MTLStorageModePrivate;
+        mMotionTexture      = angle::adoptObjCPtr([device newTextureWithDescriptor:texDesc]);
+        texDesc.pixelFormat = MTLPixelFormatR32Float;
+        mDepthCopyTexture   = angle::adoptObjCPtr([device newTextureWithDescriptor:texDesc]);
+        if (!mMotionTexture || !mDepthCopyTexture)
+        {
+            return false;
+        }
+
+        if (!mMotionPassPipeline)
+        {
+            NSError *error = nil;
+            auto library   = angle::adoptObjCPtr([device
+                newLibraryWithSource:[NSString stringWithUTF8String:kMotionPassSource]
+                             options:nil
+                               error:&error]);
+            if (!library)
+            {
+                NSLog(@"MetalFX temporal: motion pass compile failed: %@", error);
+                return false;
+            }
+            auto vertexFn   = angle::adoptObjCPtr([library.get() newFunctionWithName:@"mfxMotionVS"]);
+            auto fragmentFn = angle::adoptObjCPtr([library.get() newFunctionWithName:@"mfxMotionFS"]);
+            auto pipeDesc   = angle::adoptObjCPtr([[MTLRenderPipelineDescriptor alloc] init]);
+            pipeDesc.get().vertexFunction                  = vertexFn.get();
+            pipeDesc.get().fragmentFunction                = fragmentFn.get();
+            pipeDesc.get().colorAttachments[0].pixelFormat = MTLPixelFormatRG16Float;
+            pipeDesc.get().colorAttachments[1].pixelFormat = MTLPixelFormatR32Float;
+            mMotionPassPipeline = angle::adoptObjCPtr(
+                [device newRenderPipelineStateWithDescriptor:pipeDesc.get() error:&error]);
+            if (!mMotionPassPipeline)
+            {
+                NSLog(@"MetalFX temporal: motion pipeline creation failed: %@", error);
+                return false;
+            }
+        }
+        return true;
+    }
+#endif
+    return false;
+}
+
+bool WindowSurfaceMtl::encodeTemporalAndPresent(const gl::Context *context,
+                                                id<MTLTexture> src,
+                                                id<MTLTexture> dst)
+{
+#if ANGLE_METAL_FX_AVAILABLE
+    if (@available(macOS 13.0, macCatalyst 16.0, *))
+    {
+        ContextMtl *contextMtl = mtl::GetImpl(context);
+        if (!mDepthTexture || !ensureTemporalResources(contextMtl, src, dst))
+        {
+            return false;
+        }
+
+        const MetalFXFrameParams params = gMetalFXFrameParams;
+
+        id<MTLFXTemporalScaler> scaler = mTemporalScaler.get();
+        scaler.colorTexture            = src;
+        scaler.depthTexture            = mDepthCopyTexture.get();
+        scaler.motionTexture           = mMotionTexture.get();
+        scaler.outputTexture           = dst;
+        scaler.inputContentWidth       = static_cast<NSUInteger>(mScalerInputSize.width);
+        scaler.inputContentHeight      = static_cast<NSUInteger>(mScalerInputSize.height);
+        scaler.jitterOffsetX           = params.jitterX;
+        scaler.jitterOffsetY           = params.jitterY;
+        scaler.motionVectorScaleX      = 1.0f;
+        scaler.motionVectorScaleY      = 1.0f;
+        scaler.depthReversed           = NO;
+        scaler.reset                   = (params.reset || !params.motionValid) ? YES : NO;
+
+        MotionPassParams gpuParams;
+        std::copy(std::begin(params.reproj), std::end(params.reproj),
+                  std::begin(gpuParams.reproj));
+        gpuParams.size[0]     = static_cast<float>(mScalerInputSize.width);
+        gpuParams.size[1]     = static_cast<float>(mScalerInputSize.height);
+        gpuParams.invSize[0]  = 1.0f / gpuParams.size[0];
+        gpuParams.invSize[1]  = 1.0f / gpuParams.size[1];
+        gpuParams.motionValid = params.motionValid;
+
+        id<MTLRenderPipelineState> pipeline = mMotionPassPipeline.get();
+        id<MTLTexture> depthSrc             = mDepthTexture->get();
+        id<MTLTexture> motionTex            = mMotionTexture.get();
+        id<MTLTexture> depthCopyTex         = mDepthCopyTexture.get();
+
+        contextMtl->presentWithPreEncode(
+            context, mCurrentDrawable, [=](id<MTLCommandBuffer> cmdBuffer) {
+                MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+                pass.colorAttachments[0].texture     = motionTex;
+                pass.colorAttachments[0].loadAction  = MTLLoadActionDontCare;
+                pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+                pass.colorAttachments[1].texture     = depthCopyTex;
+                pass.colorAttachments[1].loadAction  = MTLLoadActionDontCare;
+                pass.colorAttachments[1].storeAction = MTLStoreActionStore;
+                id<MTLRenderCommandEncoder> encoder =
+                    [cmdBuffer renderCommandEncoderWithDescriptor:pass];
+                encoder.label = @"MetalFX motion pass";
+                [encoder setRenderPipelineState:pipeline];
+                [encoder setFragmentTexture:depthSrc atIndex:0];
+                [encoder setFragmentBytes:&gpuParams length:sizeof(gpuParams) atIndex:0];
+                [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+                [encoder endEncoding];
+
+                [scaler encodeToCommandBuffer:cmdBuffer];
+            });
+        return true;
+    }
+#endif
+    return false;
+}
+
+void WindowSurfaceMtl::dropTemporal()
+{
+    mTemporalScaler     = nil;
+    mMotionTexture      = nil;
+    mDepthCopyTexture   = nil;
+    mMotionPassPipeline = nil;
+    if (mUpscaleTemporal)
+    {
+        mUpscaleTemporal       = false;
+        gMetalFXTemporalActive = 0;
+    }
+}
