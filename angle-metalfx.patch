+// MetalFX temporal upscaling: per-frame parameters pushed by the client
+// (librw) through the rwANGLEMetalFX* exports at the bottom of this file.
+// The client calls rwANGLEMetalFXSetFrameParams() on the GL thread right
+// before eglSwapBuffers(), which consumes the values on the same thread, so
+// no locking is needed.
+struct MetalFXFrameParams
+{
+    float reproj[16] = {};           // cur Metal clip pos -> prev Metal clip pos, column major
+    float jitterX     = 0.0f;        // pixels at the internal resolution, [-0.5, 0.5]
+    float jitterY     = 0.0f;
+    int reset         = 0;           // 1 = drop temporal history (camera cut)
+    int motionValid   = 0;           // 0 = reprojection matrix unusable this frame
+};
+MetalFXFrameParams gMetalFXFrameParams;
+int gMetalFXTemporalActive = 0;
+
+// Constant buffer of the motion pass below; layout matches the MSL Params.
+struct alignas(16) MotionPassParams
+{
+    float reproj[16];
+    float size[2];     // internal size in pixels
+    float invSize[2];
+    int motionValid;
+    int pad[3];
+};
+
+// Fullscreen pass deriving the temporal scaler's inputs from the depth
+// buffer: camera-only motion vectors (reprojection of depth through the
+// pushed matrix) and a single-sample depth copy in a format the scaler
+// accepts. Motion is in top-left-origin pixels with scale 1: a surface point
+// that moved down-right by 10px since the previous frame gets (-10,-10).
+constexpr char kMotionPassSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct Params {
+    float4x4 reproj;
+    float2 size;
+    float2 invSize;
+    int motionValid;
+};
+
+struct VSOut { float4 pos [[position]]; };
+
+vertex VSOut mfxMotionVS(uint vid [[vertex_id]])
+{
+    VSOut o;
+    float2 uv = float2((vid << 1) & 2, vid & 2);
+    o.pos = float4(uv * 2.0 - 1.0, 0.0, 1.0);
+    return o;
+}
+
+struct FSOut {
+    float2 motion [[color(0)]];
+    float depth [[color(1)]];
+};
+
+fragment FSOut mfxMotionFS(VSOut in [[stage_in]],
+                           depth2d<float, access::read> depthTex [[texture(0)]],
+                           constant Params &p [[buffer(0)]])
+{
+    FSOut o;
+    float d = depthTex.read(uint2(in.pos.xy));
+    o.depth = d;
+    o.motion = float2(0.0);
+    if (p.motionValid != 0) {
+        // Pixel center -> Metal NDC (y up); depth is already Metal [0,1].
+        float2 ndc = float2(in.pos.x * p.invSize.x * 2.0 - 1.0,
+                            1.0 - in.pos.y * p.invSize.y * 2.0);
+        float4 prevClip = p.reproj * float4(ndc, d, 1.0);
+        if (prevClip.w > 0.0) {
+            float2 prevNdc = prevClip.xy / prevClip.w;
+            float2 prevPix = float2((prevNdc.x * 0.5 + 0.5) * p.size.x,
+                                    (0.5 - prevNdc.y * 0.5) * p.size.y);
+            o.motion = prevPix - in.pos.xy;
+        }
+    }
+    return o;
+}
+)";
+
 }  // anonymous namespace
 
